---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, withBase } from '../site.config.mjs';
import { getPublishedPosts, getTagCounts } from '../lib/posts';

const posts = await getPublishedPosts();
const tags = await getTagCounts();
const latest = posts.slice(0, SITE.postsPerPage);
---
<BaseLayout width="wide">
  <section class="hero">
    <h1>{SITE.title}</h1>
    <p>{SITE.tagline}</p>
  </section>

  <section>
    <div class="section-head">
      <h2>最新文章</h2>
      <a href={withBase('/archive/')}>全部 {posts.length} 篇 →</a>
    </div>

    {
      latest.length > 0 ? (
        <ul class="post-list">
          {latest.map((post) => (
            <PostCard post={post} />
          ))}
        </ul>
      ) : (
        <p class="empty-state">还没有文章。在 <code>src/content/posts/</code> 里新建一个 .md 文件就能开始写了。</p>
      )
    }
  </section>

  {
    tags.length > 0 && (
      <section style="margin-bottom: 3rem">
        <div class="section-head">
          <h2>标签</h2>
          <a href={withBase('/tags/')}>全部标签 →</a>
        </div>
        <ul class="tag-list">
          {tags.slice(0, 20).map(({ tag, count }) => (
            <li>
              <a class="tag" href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>
                {tag}
                <span class="tag__count">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
